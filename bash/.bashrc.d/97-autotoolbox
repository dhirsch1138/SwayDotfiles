if [[ $(istoolbx) ]]
then
  echo "Current toolbx : $(istoolbx)"
elif [[ $openedtoolbx ]]
then
  echo "client shell > $(hostname)"  
elif [[ $- == *i* ]]
then
  # this will only run in interactive shells
  declare local dotfiles_path=~/dotfiles
  declare local currentworkingdirecory=$(pwd)
  declare local toolbox_default=default.interactive
  cd $dotfiles_path
  git ls-files --full-name --modified --others --exclude-standard | grep -i bash > /dev/null && echo Warning: untracked bash changes detected
  cd $pwd
  if [[ $(toolbox list --containers | grep $toolbox_default) ]]
  then
    echo . > /dev/null
  elif [[ $(toolbox list --images | grep $toolbox_default) ]]
  then
    echo default toolbx $toolbox_default does not exist, creating
    toolbox create $toolbox_default --image localhost/default.interactive
  else
    echo default toolbx image $toolbox_default does not exist, creating image and container
    podman build --squash --tag localhost/default.interactive:latest ~/Templates/Toolbx/default.interactive
    toolbox create $toolbox_default --image localhost/default.interactive
   fi
  toolbox enter $toolbox_default
  openedtoolbx="true"
fi
